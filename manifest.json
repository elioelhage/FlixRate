{
  "manifest_version": 3,
  "name": "FlixRate",
  "version": "1.51.0",
  "description": "See IMDb episode ratings directly in the FlixRate popup while watching Netflix.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://www.netflix.com/*", "https://www.omdbapi.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "FlixRate" },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["ratings.js", "content.js"],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
